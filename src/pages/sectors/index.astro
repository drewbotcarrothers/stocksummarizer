---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import AdSlot from '../../components/AdSlot.astro';

const sectors = (await getCollection('sectors', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.updatedDate.valueOf() - a.data.updatedDate.valueOf(),
);

function fmt(d: Date) {
  return d.toLocaleDateString('en-CA', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
  });
}
---

<Layout
  title="Sector Snapshots"
  description="Theme, leaders and laggards, and the drivers that matter — in plain English. Living StockSummarizer sector deep-dives."
>
  <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <p class="text-sm font-semibold uppercase tracking-wider text-accent-dark">Content pillar</p>
    <h1 class="mt-2 font-display text-4xl font-bold">Sector Snapshots</h1>
    <p class="mt-3 text-lg text-ink-muted">
      Theme, leaders and laggards, and the drivers that matter — in plain English. Living posts refresh when the screener or catalysts move.
    </p>
    <AdSlot size="leaderboard" />

    {sectors.length === 0 ? (
      <div class="rounded-xl border border-dashed border-border bg-surface-soft p-8 text-center">
        <p class="font-medium text-ink">Placeholder</p>
        <p class="mt-2 text-sm text-ink-muted">Sector snapshot briefs are coming soon. Check back for structured sector coverage.</p>
        <a href="/summaries/" class="mt-4 inline-block text-sm font-semibold text-accent-dark">Browse stock summaries</a>
      </div>
    ) : (
      <ul class="mt-2 space-y-4">
        {sectors.map((s) => (
          <li>
            <a
              href={`/sectors/${s.id}/`}
              class="block rounded-xl border border-border bg-surface p-5 no-underline shadow-sm transition hover:border-accent-dark/40 hover:shadow-md"
            >
              <div class="flex flex-wrap items-center justify-between gap-2">
                <h2 class="font-display text-xl font-semibold text-ink">{s.data.sector}</h2>
                <span class="text-xs font-medium uppercase tracking-wide text-ink-muted">
                  Updated {fmt(s.data.updatedDate)}
                </span>
              </div>
              <p class="mt-2 text-sm leading-relaxed text-ink-muted">{s.data.thesis}</p>
              <p class="mt-3 text-sm font-semibold text-accent-dark">Read the deep-dive →</p>
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</Layout>
