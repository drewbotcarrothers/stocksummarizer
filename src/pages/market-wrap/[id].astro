---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import AdSlot from '../../components/AdSlot.astro';
import AffiliateCTA from '../../components/AffiliateCTA.astro';
import FeaturedImage from '../../components/FeaturedImage.astro';
import { FEATURED_W, FEATURED_H } from '../../lib/featured-image';

export async function getStaticPaths() {
  const wraps = await getCollection('marketWrap', ({ data }) => !data.draft);
  return wraps.map((wrap) => ({
    params: { id: wrap.id },
    props: { wrap },
  }));
}

const { wrap } = Astro.props;
const { Content } = await render(wrap);
const date = wrap.data.pubDate.toLocaleDateString('en-CA', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
const changeUp = wrap.data.tsxChange.startsWith('+') || wrap.data.tsxChange.startsWith('(+');
---

<Layout
  title={wrap.data.title}
  description={wrap.data.description}
  ogType="article"
  canonicalPath={`/market-wrap/${wrap.id}/`}
  image={wrap.data.image}
  imageAlt={wrap.data.imageAlt}
  imageWidth={wrap.data.image ? FEATURED_W : undefined}
  imageHeight={wrap.data.image ? FEATURED_H : undefined}
>
  <article class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <nav class="text-sm text-ink-muted">
      <a href="/market-wrap/" class="no-underline hover:text-accent-dark">Market Wrap</a>
      <span class="mx-2" aria-hidden="true">/</span>
      <span>{wrap.data.sessionLabel}</span>
    </nav>

    <header class="mt-4 border-b border-border pb-8">
      <div class="flex flex-wrap items-center gap-2 text-xs font-medium uppercase tracking-wide text-ink-muted">
        <span class="rounded bg-accent-soft px-2 py-0.5 text-accent-dark">{wrap.data.sessionLabel}</span>
        {
          (wrap.data.tsxClose || wrap.data.tsxChange) && (
            <span>
              {wrap.data.tsxClose && <span>TSX {wrap.data.tsxClose}</span>}
              {wrap.data.tsxChange && (
                <span class:list={[wrap.data.tsxClose ? 'ml-1' : '', 'normal-case', changeUp ? 'text-accent-dark' : 'text-danger']}>
                  {wrap.data.tsxChange}
                </span>
              )}
            </span>
          )
        }
        <span aria-hidden="true">·</span>
        <time datetime={wrap.data.pubDate.toISOString()}>{date}</time>
        <span aria-hidden="true">·</span>
        <span class="normal-case tracking-normal">{wrap.data.author}</span>
      </div>
      <h1 class="mt-4 font-display text-3xl font-bold leading-tight sm:text-4xl">{wrap.data.title}</h1>
      <p class="mt-3 text-lg text-ink-muted">{wrap.data.description}</p>
      {
        wrap.data.image && (
          <figure class="mt-6 overflow-hidden rounded-xl border border-border bg-surface-soft shadow-sm">
            <FeaturedImage
              image={wrap.data.image}
              alt={wrap.data.imageAlt}
              sizes="(min-width: 768px) 720px, calc(100vw - 2rem)"
              hero
            />
            {wrap.data.imageCredit && (
              <figcaption class="px-4 py-2 text-xs leading-5 text-ink-muted">{wrap.data.imageCredit}</figcaption>
            )}
          </figure>
        )
      }
    </header>

    <AdSlot size="inline" />

    <div class="prose-brief">
      <Content />
    </div>

    <AffiliateCTA
      title="Research tools that fit DIY investors"
      body="We may earn a commission from disclosed affiliate partners (brokers, screeners, learning platforms). We only surface tools that match our clarity-first standard."
    />

    <p class="mt-8 rounded-lg border border-border bg-surface-soft p-4 text-sm text-ink-muted">
      <strong class="text-ink">Educational only — not financial advice.</strong> Do your own research.
      See our <a href="/disclosures/">disclosures</a>.
    </p>
  </article>
</Layout>
