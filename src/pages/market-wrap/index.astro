---
import Layout from '../../layouts/Layout.astro';
import AdSlot from '../../components/AdSlot.astro';
---

<Layout
  title="Market Wrap"
  description="The broader tape in plain English — rates, risk-on/off, and big movers."
>
  <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <p class="text-sm font-semibold uppercase tracking-wider text-accent-dark">Content pillar</p>
    <h1 class="mt-2 font-display text-4xl font-bold">Market Wrap</h1>
    <p class="mt-3 text-lg text-ink-muted">The broader tape in plain English — rates, risk-on/off, and big movers.</p>
    <AdSlot size="leaderboard" />
    <div class="rounded-xl border border-dashed border-border bg-surface-soft p-8 text-center">
      <p class="font-medium text-ink">Placeholder</p>
      <p class="mt-2 text-sm text-ink-muted">Market wrap notes are coming soon.</p>
      <a href="/summaries/" class="mt-4 inline-block text-sm font-semibold text-accent-dark">Browse stock summaries</a>
    </div>
  </div>
</Layout>
