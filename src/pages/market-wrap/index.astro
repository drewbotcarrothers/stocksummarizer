---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import AdSlot from '../../components/AdSlot.astro';
import MarketWrapCard from '../../components/MarketWrapCard.astro';

const wraps = (await getCollection('marketWrap', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout
  title="Market Wrap"
  description="The broader tape in plain English — rates, risk-on/off, and big movers."
>
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <p class="text-sm font-semibold uppercase tracking-wider text-accent-dark">Content pillar</p>
    <h1 class="mt-2 font-display text-4xl font-bold">Market Wrap</h1>
    <p class="mt-3 max-w-3xl text-lg text-ink-muted">
      The broader tape in plain English — rates, risk-on/off, and big movers.
    </p>
    <AdSlot size="leaderboard" />

    {
      wraps.length === 0 ? (
        <div class="rounded-xl border border-dashed border-border bg-surface-soft p-8 text-center">
          <p class="font-medium text-ink">No market wraps yet</p>
          <p class="mt-2 text-sm text-ink-muted">Daily Canadian and TSX session notes will be listed here.</p>
          <a href="/summaries/" class="mt-4 inline-block text-sm font-semibold text-accent-dark">
            Browse stock summaries
          </a>
        </div>
      ) : (
        <ul class="mt-2 grid gap-6 md:grid-cols-2">
          {wraps.map((wrap) => (
            <li>
              <MarketWrapCard wrap={wrap} />
            </li>
          ))}
        </ul>
      )
    }
  </div>
</Layout>
