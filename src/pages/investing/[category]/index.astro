---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import AdSlot from '../../../components/AdSlot.astro';
import FeaturedImage from '../../../components/FeaturedImage.astro';
import { INVESTING_CATEGORIES, categoryBySlug, splitInvestingId } from '../../../lib/investing-categories';

export async function getStaticPaths() {
  return INVESTING_CATEGORIES.map((c) => ({ params: { category: c.slug } }));
}

const { category } = Astro.params;
const meta = categoryBySlug(category!);
if (!meta) {
  return Astro.redirect('/investing/');
}

const posts = (
  await getCollection(
    'investing',
    ({ data, id }) =>
      !data.draft && (data.category === meta.slug || splitInvestingId(id).category === meta.slug)
  )
).sort((a, b) => {
  const role = (x: typeof a) => (x.data.role === 'Hub' ? 0 : 1);
  const byRole = role(a) - role(b);
  if (byRole !== 0) return byRole;
  return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
});
---

<Layout
  title={`${meta.name} — Investing Literacy`}
  description={meta.blurb}
  canonicalPath={`/investing/${meta.slug}/`}
>
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <nav class="text-sm text-ink-muted">
      <a href="/investing/" class="no-underline hover:text-accent-dark">Investing Literacy</a>
      <span class="mx-2" aria-hidden="true">/</span>
      <span>{meta.name}</span>
    </nav>

    <p class="mt-4 text-sm font-semibold uppercase tracking-wider text-accent-dark">Investing Literacy · {meta.priority}</p>
    <h1 class="mt-2 font-display text-4xl font-bold">{meta.name}</h1>
    <p class="mt-3 max-w-3xl text-lg text-ink-muted">{meta.blurb}</p>
    <AdSlot size="leaderboard" />

    {posts.length === 0 ? (
      <div class="rounded-xl border border-dashed border-border bg-surface-soft p-8 text-center">
        <p class="font-medium text-ink">Guides in this category are queued</p>
        <p class="mt-2 text-sm text-ink-muted">We are shipping Investing Literacy hubs in priority order. Browse other categories or stock summaries meanwhile.</p>
        <a href="/investing/" class="mt-4 inline-block text-sm font-semibold text-accent-dark">All literacy categories</a>
      </div>
    ) : (
      <ul class="mt-2 grid gap-6 md:grid-cols-2">
        {posts.map((p) => {
          const { slug } = splitInvestingId(p.id);
          return (
            <li>
              <a
                href={`/investing/${meta.slug}/${slug}/`}
                class="flex h-full flex-col overflow-hidden rounded-xl border border-border bg-surface p-5 no-underline shadow-sm transition hover:border-accent-dark/40 hover:shadow-md"
              >
                {p.data.image && (
                  <span class="-mx-5 -mt-5 mb-4 block border-b border-border">
                    <FeaturedImage
                      image={p.data.image}
                      alt={p.data.imageAlt ?? ''}
                      sizes="(min-width: 768px) 560px, 100vw"
                    />
                  </span>
                )}
                <div class="flex flex-wrap items-center gap-2">
                  {p.data.role === 'Hub' && (
                    <span class="rounded bg-accent-soft px-2 py-0.5 text-xs font-medium uppercase tracking-wide text-accent-dark">Hub</span>
                  )}
                  <span class="text-xs font-medium uppercase tracking-wide text-ink-muted">{p.data.role}</span>
                </div>
                <h2 class="mt-2 font-display text-xl font-semibold text-ink">{p.data.title}</h2>
                <p class="mt-2 text-sm leading-relaxed text-ink-muted">{p.data.description}</p>
                <p class="mt-3 text-sm font-semibold text-accent-dark">Read guide →</p>
              </a>
            </li>
          );
        })}
      </ul>
    )}
  </div>
</Layout>
