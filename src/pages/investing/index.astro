---
import Layout from '../../layouts/Layout.astro';
import AdSlot from '../../components/AdSlot.astro';
---

<Layout
  title="Investing Literacy"
  description="How to read earnings, multiples, and the language of markets — without the gatekeeping."
>
  <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <p class="text-sm font-semibold uppercase tracking-wider text-accent-dark">Content pillar</p>
    <h1 class="mt-2 font-display text-4xl font-bold">Investing Literacy</h1>
    <p class="mt-3 text-lg text-ink-muted">How to read earnings, multiples, and the language of markets — without the gatekeeping.</p>
    <AdSlot size="leaderboard" />
    <div class="rounded-xl border border-dashed border-border bg-surface-soft p-8 text-center">
      <p class="font-medium text-ink">Placeholder</p>
      <p class="mt-2 text-sm text-ink-muted">Literacy guides are coming soon. Free briefs stay free; ebooks will go deeper.</p>
      <a href="/summaries/" class="mt-4 inline-block text-sm font-semibold text-accent-dark">Browse stock summaries</a>
    </div>
  </div>
</Layout>
