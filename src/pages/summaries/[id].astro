---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import AdSlot from '../../components/AdSlot.astro';
import AffiliateCTA from '../../components/AffiliateCTA.astro';
import FeaturedImage from '../../components/FeaturedImage.astro';
import { FEATURED_W, FEATURED_H } from '../../lib/featured-image';

export async function getStaticPaths() {
  const briefs = await getCollection('briefs', ({ data }) => !data.draft);
  return briefs.map((brief) => ({
    params: { id: brief.id },
    props: { brief },
  }));
}

const { brief } = Astro.props;
const { Content } = await render(brief);
const date = brief.data.pubDate.toLocaleDateString('en-CA', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'America/Toronto',
});
---

<Layout
  title={brief.data.title}
  description={brief.data.description}
  ogType="article"
  canonicalPath={`/summaries/${brief.id}/`}
  image={brief.data.image}
  imageAlt={brief.data.imageAlt}
  imageWidth={brief.data.image ? FEATURED_W : undefined}
  imageHeight={brief.data.image ? FEATURED_H : undefined}
>
  <article class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <nav class="text-sm text-ink-muted">
      <a href="/summaries/" class="no-underline hover:text-accent-dark">Stock Summaries</a>
      <span class="mx-2" aria-hidden="true">/</span>
      <span>{brief.data.ticker}</span>
    </nav>

    <header class="mt-4 border-b border-border pb-8">
      <div class="flex flex-wrap items-center gap-2 text-xs font-medium uppercase tracking-wide text-ink-muted">
        <span class="rounded bg-accent-soft px-2 py-0.5 text-accent-dark">{brief.data.ticker}</span>
        <span>{brief.data.market}</span>
        <span aria-hidden="true">·</span>
        <span>{brief.data.sector}</span>
        <span aria-hidden="true">·</span>
        <time datetime={brief.data.pubDate.toISOString()}>{date}</time>
      </div>
      <h1 class="mt-4 font-display text-3xl font-bold leading-tight sm:text-4xl">{brief.data.title}</h1>
      <p class="mt-3 text-lg text-ink-muted">{brief.data.description}</p>
      {brief.data.image && (
        <figure class="mt-6 overflow-hidden rounded-xl border border-border bg-surface-soft shadow-sm">
          <FeaturedImage
            image={brief.data.image}
            alt={brief.data.imageAlt ?? `${brief.data.company} (${brief.data.ticker}) stock analysis thumbnail`}
            sizes="(min-width: 768px) 720px, calc(100vw - 2rem)"
            hero
          />
        </figure>
      )}
      {(brief.data.price || brief.data.marketCap) && (
        <dl class="mt-6 grid gap-3 rounded-lg border border-border bg-surface-soft p-4 text-sm sm:grid-cols-3">
          {brief.data.price && (
            <div>
              <dt class="text-ink-muted">Price</dt>
              <dd class="mt-1 font-semibold text-ink">
                {brief.data.price}
                {brief.data.change && <span class="ml-1 text-accent-dark">{brief.data.change}</span>}
              </dd>
            </div>
          )}
          {brief.data.marketCap && (
            <div>
              <dt class="text-ink-muted">Market cap</dt>
              <dd class="mt-1 font-semibold text-ink">{brief.data.marketCap}</dd>
            </div>
          )}
          <div>
            <dt class="text-ink-muted">Company</dt>
            <dd class="mt-1 font-semibold text-ink">{brief.data.company}</dd>
          </div>
        </dl>
      )}
    </header>

    <AdSlot size="inline" />

    <div class="prose-brief">
      <Content />
    </div>

    <AffiliateCTA
      title="Research tools that fit DIY investors"
      body="We may earn a commission from disclosed affiliate partners (brokers, screeners, learning platforms). We only surface tools that match our clarity-first standard."
    />

    <p class="mt-8 rounded-lg border border-border bg-surface-soft p-4 text-sm text-ink-muted">
      <strong class="text-ink">Educational only — not financial advice.</strong> Do your own research.
      See our <a href="/disclosures/">disclosures</a>.
    </p>
  </article>
</Layout>
