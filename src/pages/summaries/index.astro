---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import BriefCard from '../../components/BriefCard.astro';
import AdSlot from '../../components/AdSlot.astro';

const briefs = (await getCollection('briefs', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout
  title="Stock Summaries"
  description="Free single-stock briefs: what happened, why it matters, bull case, bear case, and what to watch next."
>
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <p class="text-sm font-semibold uppercase tracking-wider text-accent-dark">Content pillar</p>
    <h1 class="mt-2 font-display text-4xl font-bold">Stock Summaries</h1>
    <p class="mt-3 max-w-2xl text-ink-muted">
      Structured briefs for DIY investors. Same sections every time so you know what you’ll get — and nothing here is paywalled.
    </p>

    <AdSlot size="leaderboard" />

    <div class="mt-2 grid gap-5 md:grid-cols-2">
      {briefs.map((brief) => <BriefCard brief={brief} />)}
    </div>
  </div>
</Layout>
