---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import BriefCard from '../components/BriefCard.astro';
import AdSlot from '../components/AdSlot.astro';
import AffiliateCTA from '../components/AffiliateCTA.astro';
import EbookCard from '../components/EbookCard.astro';

const briefs = (await getCollection('briefs', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latest = briefs.slice(0, 3);
const evergreen = (await getCollection('investing', ({ data }) => !data.draft))
  .sort((a, b) => (b.data.updatedDate ?? b.data.pubDate).valueOf() - (a.data.updatedDate ?? a.data.pubDate).valueOf())
  .slice(0, 9);
const sectorDives = (await getCollection('sectors', ({ data }) => !data.draft)).sort((a, b) => a.data.sector.localeCompare(b.data.sector));
const wraps = (await getCollection('marketWrap', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);
const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-CA', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---

<Layout
  title="StockSummarizer — Plain-English stock & market briefs"
  description="Clear, structured stock summaries, sector snapshots, and market wraps for DIY investors. Free briefs — no paywall."
>
  <section class="border-b border-border bg-gradient-to-b from-accent-soft/40 to-surface">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20">
      <p class="text-sm font-semibold uppercase tracking-wider text-accent-dark">Clear. Grounded. Useful.</p>
      <h1 class="mt-3 max-w-3xl font-display text-4xl font-bold leading-tight text-ink sm:text-5xl">
        Market noise, summarized in plain English.
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-ink-muted">
        StockSummarizer turns filings, headlines, and screen data into structured briefs —
        what happened, why it matters, bull/bear, and what to watch — so everyday DIY investors can decide faster.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="/summaries/"
          class="inline-flex rounded-md bg-accent px-5 py-3 text-sm font-semibold text-white no-underline hover:bg-accent-dark"
        >
          Browse stock summaries
        </a>
        <a
          href="/about/"
          class="inline-flex rounded-md border border-border bg-surface px-5 py-3 text-sm font-semibold text-ink no-underline hover:border-accent/40"
        >
          How we work
        </a>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <AdSlot size="leaderboard" />

    <section class="py-4">
      <div class="flex items-end justify-between gap-4">
        <div>
          <h2 class="font-display text-2xl font-semibold sm:text-3xl">Latest stock briefs</h2>
          <p class="mt-1 text-sm text-ink-muted">Free to read — never paywalled.</p>
        </div>
        <a href="/summaries/" class="text-sm font-semibold text-accent-dark no-underline hover:underline">View all</a>
      </div>
      <div class="mt-6 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {latest.map((brief) => <BriefCard brief={brief} />)}
        {latest.length === 0 && (
          <p class="text-ink-muted">Briefs coming soon.</p>
        )}
      </div>
    </section>

    {briefs.length > 0 && (
      <section class="py-8" aria-labelledby="all-summaries-heading">
        <div class="flex items-end justify-between gap-4">
          <div>
            <h2 id="all-summaries-heading" class="font-display text-2xl font-semibold sm:text-3xl">All stock summaries</h2>
            <p class="mt-1 text-sm text-ink-muted">Every brief we've published, newest first.</p>
          </div>
          <a href="/summaries/" class="text-sm font-semibold text-accent-dark no-underline hover:underline">All summaries</a>
        </div>
        <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {briefs.map((brief) => (
            <li>
              <a
                href={`/summaries/${brief.id}/`}
                class="flex h-full items-center gap-3 rounded-lg border border-border bg-surface px-4 py-3 no-underline transition hover:border-accent/40 hover:shadow-sm"
              >
                {brief.data.logo ? (
                  <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg border border-border bg-white p-1">
                    <img
                      src={brief.data.logo}
                      alt={`${brief.data.company} logo`}
                      width="40"
                      height="40"
                      loading="lazy"
                      decoding="async"
                      class="h-full w-full object-contain"
                    />
                  </span>
                ) : (
                  <span class="shrink-0 rounded bg-accent-soft px-2 py-0.5 text-xs font-semibold uppercase tracking-wide text-accent-dark">
                    {brief.data.ticker}
                  </span>
                )}
                <span class="min-w-0 flex-1">
                  <span class="flex min-w-0 items-center gap-2">
                    {brief.data.logo && (
                      <span class="shrink-0 rounded bg-accent-soft px-1.5 py-0.5 text-[11px] font-semibold uppercase leading-none tracking-wide text-accent-dark">
                        {brief.data.ticker}
                      </span>
                    )}
                    <span class="truncate text-sm font-semibold text-ink">{brief.data.company}</span>
                  </span>
                  <span class="mt-0.5 block text-xs text-ink-muted">
                    {brief.data.market} · <time datetime={brief.data.pubDate.toISOString()}>{fmtDate(brief.data.pubDate)}</time>
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="py-8" aria-labelledby="sector-dives-heading">
      <div class="flex items-end justify-between gap-4">
        <h2 id="sector-dives-heading" class="font-display text-2xl font-semibold sm:text-3xl">Sector deep dives</h2>
        <a href="/sectors/" class="text-sm font-semibold text-accent-dark no-underline hover:underline">All sectors</a>
      </div>
      <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {sectorDives.map((s) => (
          <li>
            <a href={`/sectors/${s.id}/`} class="block h-full rounded-lg border border-border bg-surface px-4 py-3 no-underline transition hover:border-accent/40 hover:shadow-sm">
              <span class="block text-xs font-semibold uppercase tracking-wide text-accent-dark">{s.data.sector}</span>
              <span class="mt-1 block text-sm font-semibold text-ink">{s.data.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="py-8" aria-labelledby="evergreen-heading">
      <div class="flex items-end justify-between gap-4">
        <h2 id="evergreen-heading" class="font-display text-2xl font-semibold sm:text-3xl">Latest investing guides</h2>
        <a href="/investing/" class="text-sm font-semibold text-accent-dark no-underline hover:underline">All guides</a>
      </div>
      <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {evergreen.map((p) => (
          <li>
            <a href={`/investing/${p.id}/`} class="block h-full rounded-lg border border-border bg-surface px-4 py-3 text-sm font-semibold text-ink no-underline transition hover:border-accent/40 hover:shadow-sm">{p.data.title}</a>
          </li>
        ))}
      </ul>
    </section>

    {wraps.length > 0 && (
      <section class="py-8" aria-labelledby="wraps-heading">
        <div class="flex items-end justify-between gap-4">
          <h2 id="wraps-heading" class="font-display text-2xl font-semibold sm:text-3xl">Latest market wraps</h2>
          <a href="/market-wrap/" class="text-sm font-semibold text-accent-dark no-underline hover:underline">All wraps</a>
        </div>
        <ul class="mt-6 space-y-2">
          {wraps.map((w) => (
            <li><a href={`/market-wrap/${w.id}/`} class="text-sm font-semibold text-accent-dark">{w.data.title}</a> <span class="text-xs text-ink-muted">· {fmtDate(w.data.pubDate)}</span></li>
          ))}
        </ul>
      </section>
    )}

    <section class="py-12">
      <h2 class="font-display text-2xl font-semibold sm:text-3xl">Explore by pillar</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {[
          { href: '/summaries/', title: 'Stock Summaries', body: 'Single-name briefs with a consistent structure.' },
          { href: '/sectors/', title: 'Sector Snapshots', body: 'Theme, leaders/laggards, and simple framing.' },
          { href: '/market-wrap/', title: 'Market Wrap', body: 'The broader tape in plain English.' },
          { href: '/investing/', title: 'Investing Literacy', body: 'How to read earnings, multiples, and more.' },
        ].map((item) => (
          <a href={item.href} class="rounded-xl border border-border bg-surface p-5 no-underline transition hover:border-accent/40 hover:shadow-sm">
            <h3 class="font-display text-lg font-semibold text-ink">{item.title}</h3>
            <p class="mt-2 text-sm text-ink-muted">{item.body}</p>
          </a>
        ))}
      </div>
    </section>

    <AffiliateCTA />

    <section class="pb-12">
      <div class="flex items-end justify-between gap-4">
        <div>
          <h2 class="font-display text-2xl font-semibold sm:text-3xl">Ebooks & guides</h2>
          <p class="mt-1 text-sm text-ink-muted">Deeper frameworks on top of free briefs — not a paywall.</p>
        </div>
        <a href="/ebooks/" class="text-sm font-semibold text-accent-dark no-underline hover:underline">See all</a>
      </div>
      <div class="mt-6 grid gap-5 md:grid-cols-2">
        <EbookCard
          title="How to Read an Earnings Release"
          description="A practical checklist for DIY investors: revenue vs. profit, guidance, footnotes, and the three numbers that usually matter most."
          priceLabel="Guide · TBD"
        />
        <EbookCard
          title="Bull / Bear / Watch — A Briefing Framework"
          description="Use our brief structure on any stock: separate facts from narrative, map risks, and write your own watchlist notes."
          priceLabel="Playbook · TBD"
        />
      </div>
    </section>
  </div>
</Layout>
