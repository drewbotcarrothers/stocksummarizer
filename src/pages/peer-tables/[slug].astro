---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { extractPeerTables, inlineMd, type PeerTable } from '../../lib/peer-tables';

export async function getStaticPaths() {
  const sectors = await getCollection('sectors', ({ data }) => !data.draft);
  return sectors
    .map((sector) => ({ sector, tables: extractPeerTables(sector.body ?? '') }))
    .filter((x) => x.tables.length > 0)
    .map(({ sector, tables }) => ({ params: { slug: sector.id }, props: { sector, tables } }));
}

const { sector, tables } = Astro.props as { sector: any; tables: PeerTable[] };
const site = 'https://stocksummarizer.com';
const asOf = sector.data.screenerDate.toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const embedCode = (t: PeerTable) =>
  `<iframe src="${site}/embed/peer-tables/${sector.id}/${t.key}/" title="${sector.data.sector} ${t.key} peer table - StockSummarizer" width="100%" height="${120 + t.rows.length * 40}" style="border:0;max-width:760px" loading="lazy"></iframe>\n<p style="font-size:13px">Table: <a href="${site}/peer-tables/${sector.id}/">StockSummarizer</a></p>`;
---

<Layout
  title={`${sector.data.sector} peer comparison tables (TSX)`}
  description={`Free, embeddable ${sector.data.sector.toLowerCase()} peer tables for TSX stocks: price, market cap, returns, valuation, dividends and analyst targets, data as of ${asOf}.`}
  canonicalPath={`/peer-tables/${sector.id}/`}
>
  <article class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <nav class="text-sm text-ink-muted">
      <a href="/peer-tables/" class="no-underline hover:text-accent-dark">Peer tables</a>
      <span class="mx-2" aria-hidden="true">/</span>
      <span>{sector.data.sector}</span>
    </nav>
    <h1 class="mt-4 font-display text-3xl font-bold leading-tight sm:text-4xl">{sector.data.sector} peer comparison tables</h1>
    <p class="mt-3 text-lg text-ink-muted">
      Data as of {asOf}. For the story behind these numbers, read the
      <a href={`/sectors/${sector.id}/`}>{sector.data.sector.toLowerCase()} sector deep dive</a>. Each table below has free embed code.
    </p>
    <div class="prose-brief">
      {tables.map((t) => (
        <section id={t.key}>
          <h2>{t.title}</h2>
          <table>
            <thead><tr>{t.header.map((h, i) => <th style={`text-align:${t.align[i] ?? 'left'}`} set:html={inlineMd(h)} />)}</tr></thead>
            <tbody>{t.rows.map((r) => <tr>{r.map((c, i) => <td style={`text-align:${t.align[i] ?? 'left'}`} set:html={inlineMd(c)} />)}</tr>)}</tbody>
          </table>
          {t.note && <p class="text-sm text-ink-muted" set:html={inlineMd(t.note)} />}
          <details class="mt-2">
            <summary class="cursor-pointer text-sm font-medium">Embed this table</summary>
            <textarea readonly rows="4" class="mt-2 w-full rounded border border-border p-2 font-mono text-xs" onclick="this.select()">{embedCode(t)}</textarea>
          </details>
        </section>
      ))}
    </div>
    <p class="mt-8 text-sm text-ink-muted">Not investment advice. Free to embed or quote with a link to StockSummarizer.</p>
  </article>
</Layout>
