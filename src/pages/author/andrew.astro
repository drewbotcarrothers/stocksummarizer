---
import Layout from '../../layouts/Layout.astro';
import JsonLd from '../../components/JsonLd.astro';
import { AUTHOR_BIO, AUTHOR_URL, SITE, breadcrumbLd } from '../../lib/seo';
const person = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: { '@type': 'Person', name: 'Andrew', url: AUTHOR_URL, description: AUTHOR_BIO, worksFor: { '@type': 'Organization', name: 'StockSummarizer', url: SITE } },
};
---
<Layout title="Andrew — Author" description="About Andrew, the author behind StockSummarizer's stock summaries, sector deep dives, market wraps and investing guides." canonicalPath="/author/andrew/">
  <JsonLd slot="head" data={[person, breadcrumbLd([{ name: 'Home', url: '/' }, { name: 'Andrew', url: '/author/andrew/' }])]} />
  <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <h1 class="font-display text-4xl font-bold">Andrew</h1>
    <p class="mt-4 text-lg leading-8 text-ink-muted">{AUTHOR_BIO}</p>
    <p class="mt-6">Andrew writes every StockSummarizer piece:</p>
    <ul class="mt-3 list-disc space-y-1 pl-6">
      <li><a href="/summaries/">Stock summaries</a></li>
      <li><a href="/sectors/">Sector deep dives</a></li>
      <li><a href="/market-wrap/">Market wraps</a></li>
      <li><a href="/investing/">Investing literacy guides</a></li>
    </ul>
    <p class="mt-6 text-sm text-ink-muted">See <a href="/about/">About StockSummarizer</a> and our <a href="/disclosures/">disclosures</a>.</p>
  </div>
</Layout>
