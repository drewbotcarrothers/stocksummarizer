---
const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-border bg-surface-soft">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 sm:px-6 md:grid-cols-3">
    <div>
      <p class="font-display text-lg font-semibold text-ink">StockSummarizer</p>
      <p class="mt-2 text-sm text-ink-muted">
        Clear. Grounded. Useful. Plain-English stock, sector, and market briefs for DIY investors.
      </p>
    </div>
    <div>
      <p class="text-sm font-semibold uppercase tracking-wide text-ink">Explore</p>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a href="/summaries/" class="text-ink-muted no-underline hover:text-accent-dark">Stock Summaries</a></li>
        <li><a href="/sectors/" class="text-ink-muted no-underline hover:text-accent-dark">Sector Snapshots</a></li>
        <li><a href="/market-wrap/" class="text-ink-muted no-underline hover:text-accent-dark">Market Wrap</a></li>
        <li><a href="/investing/" class="text-ink-muted no-underline hover:text-accent-dark">Investing Literacy</a></li>
        <li><a href="/ebooks/" class="text-ink-muted no-underline hover:text-accent-dark">Ebooks & Guides</a></li>
      </ul>
    </div>
    <div>
      <p class="text-sm font-semibold uppercase tracking-wide text-ink">Legal</p>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a href="/about/" class="text-ink-muted no-underline hover:text-accent-dark">About</a></li>
        <li><a href="/disclosures/" class="text-ink-muted no-underline hover:text-accent-dark">Disclosures</a></li>
      </ul>
      <p class="mt-4 text-xs leading-5 text-ink-muted">
        Educational content only — not personalized financial advice. Investing involves risk, including loss of principal.
      </p>
    </div>
  </div>
  <div class="border-t border-border">
    <p class="mx-auto max-w-6xl px-4 py-4 text-xs text-ink-muted sm:px-6">
      © {year} StockSummarizer · stocksummarizer.com
    </p>
  </div>
</footer>
