---
import type { CollectionEntry } from 'astro:content';
import FeaturedImage from './FeaturedImage.astro';

interface Props {
  wrap: CollectionEntry<'marketWrap'>;
}

const { wrap } = Astro.props;
const date = wrap.data.pubDate.toLocaleDateString('en-CA', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
});
const changeUp = wrap.data.tsxChange.startsWith('+') || wrap.data.tsxChange.startsWith('(+');
---

<a
  href={`/market-wrap/${wrap.id}/`}
  class="flex h-full flex-col overflow-hidden rounded-xl border border-border bg-surface p-5 no-underline shadow-sm transition hover:border-accent-dark/40 hover:shadow-md"
>
  {
    wrap.data.image && (
      <span class="-mx-5 -mt-5 mb-4 block border-b border-border">
        <FeaturedImage
          image={wrap.data.image}
          alt={wrap.data.imageAlt}
          sizes="(min-width: 768px) 560px, 100vw"
        />
      </span>
    )
  }
  <div class="flex flex-wrap items-center justify-between gap-2">
    <span class="rounded bg-accent-soft px-2 py-0.5 text-xs font-medium uppercase tracking-wide text-accent-dark">
      {wrap.data.sessionLabel}
    </span>
    <time
      class="text-xs font-medium uppercase tracking-wide text-ink-muted"
      datetime={wrap.data.pubDate.toISOString()}
    >
      {date}
    </time>
  </div>
  <h2 class="mt-3 font-display text-xl font-semibold text-ink">{wrap.data.title}</h2>
  <p class="mt-2 text-sm leading-relaxed text-ink-muted">{wrap.data.description}</p>
  {
    (wrap.data.tsxClose || wrap.data.tsxChange) && (
      <p class="mt-4 text-sm font-medium text-ink">
        {wrap.data.tsxClose && <span>TSX {wrap.data.tsxClose}</span>}
        {wrap.data.tsxChange && (
          <span class:list={['ml-2', changeUp ? 'text-accent-dark' : 'text-danger']}>{wrap.data.tsxChange}</span>
        )}
      </p>
    )
  }
</a>
