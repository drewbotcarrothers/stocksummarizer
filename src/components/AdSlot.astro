---
interface Props {
  label?: string;
  size?: 'leaderboard' | 'rectangle' | 'inline';
}

const { label = 'Advertisement', size = 'leaderboard' } = Astro.props;

const sizeClass =
  size === 'rectangle'
    ? 'min-h-[250px] max-w-sm'
    : size === 'inline'
      ? 'min-h-[90px]'
      : 'min-h-[90px] md:min-h-[100px]';
---

<aside
  class:list={[
    'my-8 flex w-full flex-col items-center justify-center rounded-lg border border-dashed border-border bg-surface-soft px-4 py-6 text-center',
    sizeClass,
  ]}
  aria-label={label}
  data-ad-slot={size}
>
  <p class="text-[11px] font-semibold uppercase tracking-wider text-ink-muted">{label}</p>
  <p class="mt-1 text-sm text-ink-muted">Ad slot placeholder · {size}</p>
</aside>
