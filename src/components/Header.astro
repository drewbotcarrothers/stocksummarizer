---
const pathname = Astro.url.pathname;

const links = [
  { href: '/summaries/', label: 'Stock Summaries' },
  { href: '/sectors/', label: 'Sectors' },
  { href: '/market-wrap/', label: 'Market Wrap' },
  { href: '/investing/', label: 'Investing Literacy' },
  { href: '/ebooks/', label: 'Ebooks & Guides' },
  { href: '/about/', label: 'About' },
];

function isActive(href: string) {
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(href);
}
---

<header class="sticky top-0 z-40 border-b border-border bg-surface/95 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a href="/" class="group flex items-center gap-2 no-underline">
      <img
        src="/logo.png"
        alt=""
        width="32"
        height="32"
        class="h-8 w-8 rounded-md"
        aria-hidden="true"
      />
      <span class="font-display text-lg font-semibold tracking-tight text-ink group-hover:text-accent-dark">StockSummarizer</span>
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={[
            'rounded-md px-3 py-2 text-sm font-medium no-underline transition-colors',
            isActive(link.href)
              ? 'bg-accent-soft text-accent-dark'
              : 'text-ink-muted hover:bg-surface-soft hover:text-ink',
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <details class="relative lg:hidden">
      <summary class="cursor-pointer list-none rounded-md border border-border px-3 py-2 text-sm font-medium text-ink">
        Menu
      </summary>
      <div class="absolute right-0 mt-2 w-56 rounded-lg border border-border bg-surface p-2 shadow-lg">
        {links.map((link) => (
          <a
            href={link.href}
            class:list={[
              'block rounded-md px-3 py-2 text-sm no-underline',
              isActive(link.href) ? 'bg-accent-soft text-accent-dark' : 'text-ink-muted hover:bg-surface-soft',
            ]}
          >
            {link.label}
          </a>
        ))}
        <a href="/disclosures/" class="mt-1 block rounded-md px-3 py-2 text-sm text-ink-muted no-underline hover:bg-surface-soft">Disclosures</a>
      </div>
    </details>
  </div>
</header>
