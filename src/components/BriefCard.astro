---
import type { CollectionEntry } from 'astro:content';
import FeaturedImage from './FeaturedImage.astro';

interface Props {
  brief: CollectionEntry<'briefs'>;
}

const { brief } = Astro.props;
const date = brief.data.pubDate.toLocaleDateString('en-CA', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  timeZone: 'America/Toronto',
});
---

<article class="overflow-hidden rounded-xl border border-border bg-surface p-5 shadow-sm transition hover:border-accent/40 hover:shadow-md">
  {brief.data.image && (
    <a href={`/summaries/${brief.id}/`} class="-mx-5 -mt-5 mb-4 block border-b border-border" tabindex="-1" aria-hidden="true">
      <FeaturedImage
        image={brief.data.image}
        alt=""
        sizes="(min-width: 1024px) 360px, (min-width: 768px) 50vw, 100vw"
      />
    </a>
  )}
  <div class="flex flex-wrap items-center gap-2 text-xs font-medium uppercase tracking-wide text-ink-muted">
    <span class="rounded bg-accent-soft px-2 py-0.5 text-accent-dark">{brief.data.ticker}</span>
    <span>{brief.data.market}</span>
    <span aria-hidden="true">·</span>
    <time datetime={brief.data.pubDate.toISOString()}>{date}</time>
  </div>
  <h3 class="mt-3 font-display text-xl font-semibold text-ink">
    <a href={`/summaries/${brief.id}/`} class="text-ink no-underline hover:text-accent-dark">
      {brief.data.title}
    </a>
  </h3>
  <p class="mt-2 text-sm leading-6 text-ink-muted">{brief.data.description}</p>
  {(brief.data.price || brief.data.change) && (
    <p class="mt-4 text-sm font-medium text-ink">
      {brief.data.price}
      {brief.data.change && (
        <span class:list={['ml-2', brief.data.change.startsWith('+') || brief.data.change.startsWith('(+') ? 'text-accent-dark' : 'text-danger']}>
          {brief.data.change}
        </span>
      )}
    </p>
  )}
</article>
