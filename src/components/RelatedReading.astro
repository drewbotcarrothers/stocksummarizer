---
import type { LinkItem } from '../lib/seo';
interface Props { links: LinkItem[]; title?: string }
const { links, title = 'Related reading' } = Astro.props;
---
{links.length > 0 && (
  <section class="my-10 rounded-xl border border-border bg-surface-soft p-6" aria-labelledby="related-reading">
    <h2 id="related-reading" class="font-display text-xl font-semibold text-ink">{title}</h2>
    <ul class="mt-4 space-y-3">
      {links.map((l) => (
        <li>
          <span class="block text-xs font-semibold uppercase tracking-wide text-ink-muted">{l.kind}</span>
          <a href={l.href} class="text-sm font-semibold text-accent-dark">{l.title}</a>
        </li>
      ))}
    </ul>
  </section>
)}
